# Core
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://moobee:change-me@postgres:5432/moobee_stream
REDIS_URL=redis://redis:6379

# Change both values before deployment.
POSTGRES_PASSWORD=change-me
ADMIN_API_KEY=replace-with-a-long-random-secret
STREAM_SIGNING_SECRET=replace-with-a-second-long-random-secret

# Public URL shown to iframe consumers.
PUBLIC_EMBED_BASE_URL=https://embed.example.com

# Signed HLS URLs are valid for this many seconds.
STREAM_TOKEN_TTL_SECONDS=7200

# Upload limits.
MAX_UPLOAD_BYTES=21474836480

# Optional CORS origin list. Use * only during development.
CORS_ORIGIN=*
